<?xml version="1.0"?>
<robot name="quadrotor_uav" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Include materials and gazebo properties -->
  <xacro:include filename="quadrotor_materials.xacro" />

  <!-- Quadrotor Physical Properties -->
  <xacro:property name="arm_length" value="0.22" />
  <xacro:property name="arm_angle" value="${pi/4}" />
  <xacro:property name="body_mass" value="1.20" />
  <xacro:property name="motor_mass" value="0.06" />
  <xacro:property name="rotor_mass" value="0.015" />
  <xacro:property name="prop_radius" value="0.12" />

  <!-- Base footprint: Ground projection -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- Base Link: Central airframe -->
  <link name="base_link">
    <!-- Inertial properties of main body -->
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.014" ixy="0.0" ixz="0.0" iyy="0.014" iyz="0.0" izz="0.025"/>
    </inertial>

    <!-- Lower center carbon plate -->
    <visual>
      <origin xyz="0 0 -0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.10" length="0.003"/>
      </geometry>
      <material name="carbon_fiber"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.20 0.08"/>
      </geometry>
    </collision>

    <!-- Upper center carbon plate -->
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.09" length="0.003"/>
      </geometry>
      <material name="carbon_fiber"/>
    </visual>

    <!-- Flight Controller / Avionics Canopy -->
    <visual>
      <origin xyz="0 0 0.028" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.065 0.024"/>
      </geometry>
      <material name="chassis_top"/>
    </visual>

    <!-- LiPo Battery Pack (mounted under frame) -->
    <visual>
      <origin xyz="0 0 -0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.13 0.05 0.035"/>
      </geometry>
      <material name="anodized_blue"/>
    </visual>

    <!-- FPV Camera Mount -->
    <visual>
      <origin xyz="0.095 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.03 0.03"/>
      </geometry>
      <material name="camera_body"/>
    </visual>

    <!-- FPV Camera Lens -->
    <visual>
      <origin xyz="0.11 0 0.01" rpy="0 ${pi/2} 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.008"/>
      </geometry>
      <material name="camera_lens"/>
    </visual>

    <!-- GPS Antenna Mast -->
    <visual>
      <origin xyz="-0.05 0 0.05" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.003" length="0.07"/>
      </geometry>
      <material name="gps_mast"/>
    </visual>
    <visual>
      <origin xyz="-0.05 0 0.088" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.012"/>
      </geometry>
      <material name="chassis_top"/>
    </visual>
  </link>

  <!-- Landing Gear: Left Skid -->
  <link name="landing_skid_left">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.24"/>
      </geometry>
      <material name="landing_skid"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.24"/>
      </geometry>
    </collision>
  </link>

  <joint name="landing_skid_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="landing_skid_left"/>
    <origin xyz="0 0.09 -0.10" rpy="0 0 0"/>
  </joint>

  <!-- Landing Gear: Right Skid -->
  <link name="landing_skid_right">
    <visual>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.24"/>
      </geometry>
      <material name="landing_skid"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      <geometry>
        <cylinder radius="0.006" length="0.24"/>
      </geometry>
    </collision>
  </link>

  <joint name="landing_skid_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="landing_skid_right"/>
    <origin xyz="0 -0.09 -0.10" rpy="0 0 0"/>
  </joint>

  <!-- Left Skid Struts -->
  <link name="skid_struts_left">
    <visual>
      <origin xyz="0.06 0.045 -0.05" rpy="0 0.35 0.5"/>
      <geometry><cylinder radius="0.004" length="0.12"/></geometry>
      <material name="landing_skid"/>
    </visual>
    <visual>
      <origin xyz="-0.06 0.045 -0.05" rpy="0 -0.35 0.5"/>
      <geometry><cylinder radius="0.004" length="0.12"/></geometry>
      <material name="landing_skid"/>
    </visual>
  </link>
  <joint name="skid_struts_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="skid_struts_left"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Right Skid Struts -->
  <link name="skid_struts_right">
    <visual>
      <origin xyz="0.06 -0.045 -0.05" rpy="0 0.35 -0.5"/>
      <geometry><cylinder radius="0.004" length="0.12"/></geometry>
      <material name="landing_skid"/>
    </visual>
    <visual>
      <origin xyz="-0.06 -0.045 -0.05" rpy="0 -0.35 -0.5"/>
      <geometry><cylinder radius="0.004" length="0.12"/></geometry>
      <material name="landing_skid"/>
    </visual>
  </link>
  <joint name="skid_struts_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="skid_struts_right"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Macro for Arm, Motor and Propeller assembly -->
  <xacro:macro name="quad_arm" params="id x y angle arm_color prop_color">
    <!-- Arm Link -->
    <link name="arm_${id}">
      <inertial>
        <mass value="0.04"/>
        <origin xyz="${arm_length*cos(angle)/2} ${arm_length*sin(angle)/2} 0" rpy="0 0 0"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
      </inertial>
      <!-- Tubular carbon arm tube -->
      <visual>
        <origin xyz="${arm_length*cos(angle)/2} ${arm_length*sin(angle)/2} 0" rpy="${pi/2} 0 ${angle - pi/2}"/>
        <geometry>
          <cylinder radius="0.008" length="${arm_length}"/>
        </geometry>
        <material name="carbon_fiber"/>
      </visual>
      <!-- Motor mount clamp -->
      <visual>
        <origin xyz="${arm_length*cos(angle)} ${arm_length*sin(angle)} 0.004" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.016" length="0.012"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <!-- Brushless motor stator -->
      <visual>
        <origin xyz="${arm_length*cos(angle)} ${arm_length*sin(angle)} 0.016" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.016"/>
        </geometry>
        <material name="motor_bell"/>
      </visual>
      <collision>
        <origin xyz="${arm_length*cos(angle)} ${arm_length*sin(angle)} 0.016" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.016" length="0.035"/>
        </geometry>
      </collision>
    </link>

    <joint name="arm_${id}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="arm_${id}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Propeller Rotor Link -->
    <link name="rotor_${id}">
      <inertial>
        <mass value="${rotor_mass}"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00004"/>
      </inertial>
      <!-- Central prop hub -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.012" length="0.012"/>
        </geometry>
        <material name="${arm_color}"/>
      </visual>
      <!-- Propeller Blade 1 -->
      <visual>
        <origin xyz="${prop_radius/2} 0 0" rpy="0.1 0 0"/>
        <geometry>
          <box size="${prop_radius} 0.018 0.002"/>
        </geometry>
        <material name="${prop_color}"/>
      </visual>
      <!-- Propeller Blade 2 -->
      <visual>
        <origin xyz="-${prop_radius/2} 0 0" rpy="-0.1 0 0"/>
        <geometry>
          <box size="${prop_radius} 0.018 0.002"/>
        </geometry>
        <material name="${prop_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${prop_radius}" length="0.015"/>
        </geometry>
      </collision>
    </link>

    <!-- Continuous joint allowing motor spinning -->
    <joint name="rotor_${id}_joint" type="continuous">
      <parent link="arm_${id}"/>
      <child link="rotor_${id}"/>
      <origin xyz="${arm_length*cos(angle)} ${arm_length*sin(angle)} 0.028" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="10.0" velocity="250.0"/>
      <dynamics damping="0.003" friction="0.002"/>
    </joint>
  </xacro:macro>

  <!-- Instantiate 4 Quadrotor Arms & Rotors (X-Configuration) -->
  <!-- Motor 0: Front-Right (+X, -Y) -> Red Propeller -->
  <xacro:quad_arm id="0" x="${arm_length}" y="-${arm_length}" angle="-0.785398" arm_color="anodized_red" prop_color="propeller_red"/>

  <!-- Motor 1: Front-Left (+X, +Y) -> Red Propeller -->
  <xacro:quad_arm id="1" x="${arm_length}" y="${arm_length}" angle="0.785398" arm_color="anodized_red" prop_color="propeller_red"/>

  <!-- Motor 2: Rear-Left (-X, +Y) -> Black Propeller -->
  <xacro:quad_arm id="2" x="-${arm_length}" y="${arm_length}" angle="2.35619" arm_color="anodized_blue" prop_color="propeller_black"/>

  <!-- Motor 3: Rear-Right (-X, -Y) -> Black Propeller -->
  <xacro:quad_arm id="3" x="-${arm_length}" y="-${arm_length}" angle="-2.35619" arm_color="anodized_blue" prop_color="propeller_black"/>

  <!-- IMU Sensor Link -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Plugin for Propeller Joint Spinning Animation -->
  <gazebo>
    <plugin name="gazebo_ros_joint_pose_trajectory" filename="libgazebo_ros_joint_pose_trajectory.so">
      <ros>
        <namespace>/uav</namespace>
        <remapping>set_joint_trajectory:=joint_trajectory</remapping>
      </ros>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>
