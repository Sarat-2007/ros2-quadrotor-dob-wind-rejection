<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Atmospheric Physics & Lighting -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Gazebo ROS State Bridge: advertises /gazebo/set_entity_state & /gazebo/get_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>
  </world>
</sdf>
