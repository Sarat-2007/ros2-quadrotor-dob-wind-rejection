<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- Atmospheric Physics & Lighting -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Gazebo ROS State Bridge: advertises /gazebo/set_entity_state & /gazebo/get_entity_state -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <!-- 1. Central Takeoff Helipad (Origin) -->
    <model name="takeoff_helipad">
      <static>true</static>
      <pose>0 0 0.005 0 0 0</pose>
      <link name="pad_link">
        <visual name="pad_visual">
          <geometry>
            <cylinder>
              <radius>1.2</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Yellow</name>
            </script>
          </material>
        </visual>
        <collision name="pad_collision">
          <geometry>
            <cylinder>
              <radius>1.2</radius>
              <length>0.01</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 2. Elevated Rooftop Landing Station (6m East, 2.0m High) -->
    <model name="rooftop_station">
      <static>true</static>
      <pose>6.0 0 1.0 0 0 0</pose>
      <link name="building_link">
        <visual name="structure_visual">
          <geometry>
            <box>
              <size>3.2 3.2 2.0</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        <collision name="structure_collision">
          <geometry>
            <box>
              <size>3.2 3.2 2.0</size>
            </box>
          </geometry>
        </collision>
      </link>
      <!-- Rooftop Landing Target -->
      <link name="roof_pad_link">
        <pose>0 0 1.01 0 0 0</pose>
        <visual name="roof_pad_visual">
          <geometry>
            <cylinder>
              <radius>1.0</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Orange</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 3. Fly-Through Inspection Gate / Arch (5m North) -->
    <model name="inspection_gate">
      <static>true</static>
      <pose>0 5.0 0 0 0 0</pose>
      <!-- Left Pillar -->
      <link name="gate_pillar_left">
        <pose>-1.6 0 2.0 0 0 0</pose>
        <visual name="left_p_vis">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
        <collision name="left_p_col">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
        </collision>
      </link>
      <!-- Right Pillar -->
      <link name="gate_pillar_right">
        <pose>1.6 0 2.0 0 0 0</pose>
        <visual name="right_p_vis">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material>
        </visual>
        <collision name="right_p_col">
          <geometry><cylinder><radius>0.2</radius><length>4.0</length></cylinder></geometry>
        </collision>
      </link>
      <!-- Top Crossbar -->
      <link name="gate_crossbar">
        <pose>0 0 4.0 0 0 0</pose>
        <visual name="bar_vis">
          <geometry><box><size>3.6 0.4 0.3</size></box></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Yellow</name></script></material>
        </visual>
        <collision name="bar_col">
          <geometry><box><size>3.6 0.4 0.3</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- 4. Industrial Tower A (7m East, -6m South, 7.5m Tall) -->
    <model name="industrial_tower_a">
      <static>true</static>
      <pose>7.0 -6.0 3.75 0 0 0</pose>
      <link name="tower_link">
        <visual name="tower_visual">
          <geometry>
            <box>
              <size>4.0 4.0 7.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <collision name="tower_collision">
          <geometry>
            <box>
              <size>4.0 4.0 7.5</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 5. Industrial Tower B (-6m West, -6m South, 6.0m Tall) -->
    <model name="industrial_tower_b">
      <static>true</static>
      <pose>-6.0 -6.0 3.0 0 0 0</pose>
      <link name="tower_b_link">
        <visual name="tower_b_visual">
          <geometry>
            <box>
              <size>3.5 4.5 6.0</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGrey</name>
            </script>
          </material>
        </visual>
        <collision name="tower_b_collision">
          <geometry>
            <box>
              <size>3.5 4.5 6.0</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- 6. Slalom Navigation Obstacle Columns -->
    <model name="slalom_pylon_1">
      <static>true</static>
      <pose>4.0 4.0 2.5 0 0 0</pose>
      <link name="pylon_link">
        <visual name="p_vis"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="p_col"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="slalom_pylon_2">
      <static>true</static>
      <pose>-4.0 4.0 2.5 0 0 0</pose>
      <link name="pylon_link">
        <visual name="p_vis"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="p_col"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="slalom_pylon_3">
      <static>true</static>
      <pose>-5.0 0 2.5 0 0 0</pose>
      <link name="pylon_link">
        <visual name="p_vis"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Orange</name></script></material></visual>
        <collision name="p_col"><geometry><cylinder><radius>0.35</radius><length>5.0</length></cylinder></geometry></collision>
      </link>
    </model>

    <model name="slalom_pylon_4">
      <static>true</static>
      <pose>0 -4.0 2.0 0 0 0</pose>
      <link name="pylon_link">
        <visual name="p_vis"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry>
        <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
        <collision name="p_col"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision>
      </link>
    </model>

  </world>
</sdf>
